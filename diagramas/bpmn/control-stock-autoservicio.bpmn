<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_stock" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude" exporterVersion="1.0">
<bpmn:signal id="Signal_alerta" name="Alerta de stock mínimo" />
<bpmn:collaboration id="Collaboration_stock">
<bpmn:participant id="Prov" name="Proveedores (viajantes y mayoristas)" />
<bpmn:participant id="Main" name="Autoservicio Express Urdinarrain" processRef="Process_stock" />
<bpmn:participant id="Ent" name="Software Enterprise (facturación electrónica / ARCA)" />
<bpmn:messageFlow id="Msg_pedido" name="Pedido de compra" sourceRef="C4" targetRef="Prov" />
<bpmn:messageFlow id="Msg_entrega" name="Mercadería + remito" sourceRef="Prov" targetRef="C5" />
<bpmn:messageFlow id="Msg_venta" name="Datos de la venta" sourceRef="A6" targetRef="Ent" />
<bpmn:messageFlow id="Msg_ticket" name="Ticket fiscal / CAE" sourceRef="Ent" targetRef="A6" />
</bpmn:collaboration>
<bpmn:process id="Process_stock" name="Control de stock" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="Lane_admin" name="Administración (Dirección / Subdirección)">
<bpmn:flowNodeRef>C3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C11</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_cocina" name="Encargado de Cocina">
<bpmn:flowNodeRef>D3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>D4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>D5</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_sistema" name="Módulo de Control de Stock (sistema)">
<bpmn:flowNodeRef>D1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>D2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>C2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A11</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A12</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A13</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A14</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A15</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_caja" name="Cajeros / Repositores">
<bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>B7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E8</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="D1" name="Mediodía (todos los días)"><bpmn:outgoing>Flow_D1_D2</bpmn:outgoing><bpmn:timerEventDefinition id="D1_def" /></bpmn:startEvent>
<bpmn:serviceTask id="D2" name="Calcular sugerido de producción (historial de ventas)"><bpmn:documentation>Usa el historial de VENTA del mismo día de las últimas semanas para sugerir cuántas comidas elaborar.</bpmn:documentation><bpmn:incoming>Flow_D1_D2</bpmn:incoming><bpmn:outgoing>Flow_D2_D3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="D3" name="Elaborar comidas según el sugerido"><bpmn:incoming>Flow_D2_D3</bpmn:incoming><bpmn:outgoing>Flow_D3_D4</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="D4" name="Registrar unidades elaboradas"><bpmn:incoming>Flow_D3_D4</bpmn:incoming><bpmn:outgoing>Flow_D4_D5</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="D5" name="Producción lista para la venta"><bpmn:incoming>Flow_D4_D5</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="C1" name="Previo a la visita del viajante (semanal)"><bpmn:outgoing>Flow_C1_C2</bpmn:outgoing><bpmn:timerEventDefinition id="C1_def" /></bpmn:startEvent>
<bpmn:serviceTask id="C2" name="Generar sugerido de orden de compra"><bpmn:documentation>Cruza historial de ventas, stock_actual, stock_minimo y alertas de reposición de PRODUCTO.</bpmn:documentation><bpmn:incoming>Flow_C1_C2</bpmn:incoming><bpmn:outgoing>Flow_C2_C3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="C3" name="Revisar y ajustar el sugerido de compra"><bpmn:incoming>Flow_C2_C3</bpmn:incoming><bpmn:outgoing>Flow_C3_C4</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="C4" name="Enviar pedido al proveedor"><bpmn:documentation>Proveedor identificado en la entidad PROVEEDOR (dias_visita, telefono_contacto).</bpmn:documentation><bpmn:incoming>Flow_C3_C4</bpmn:incoming><bpmn:outgoing>Flow_C4_C5</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="C5" name="Mercadería y remito recibidos"><bpmn:incoming>Flow_C4_C5</bpmn:incoming><bpmn:outgoing>Flow_C5_C6</bpmn:outgoing><bpmn:messageEventDefinition id="C5_def" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="C6" name="Controlar mercadería contra remito / factura"><bpmn:incoming>Flow_C5_C6</bpmn:incoming><bpmn:outgoing>Flow_C6_C7</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="C7" name="¿Conforme?"><bpmn:incoming>Flow_C6_C7</bpmn:incoming><bpmn:outgoing>Flow_C7_C9</bpmn:outgoing><bpmn:outgoing>Flow_C7_C8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="C8" name="Reclamar diferencias al proveedor"><bpmn:incoming>Flow_C7_C8</bpmn:incoming><bpmn:outgoing>Flow_C8_C9</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="C9"><bpmn:incoming>Flow_C7_C9</bpmn:incoming><bpmn:incoming>Flow_C8_C9</bpmn:incoming><bpmn:outgoing>Flow_C9_C10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="C10" name="Cargar ingreso en el módulo (stock y costos)"><bpmn:documentation>Actualiza stock_actual de PRODUCTO y registra el costo de compra.</bpmn:documentation><bpmn:incoming>Flow_C9_C10</bpmn:incoming><bpmn:outgoing>Flow_C10_C11</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="C11" name="Stock actualizado"><bpmn:incoming>Flow_C10_C11</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="A1" name="Cliente llega a caja"><bpmn:outgoing>Flow_A1_A2</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="A2" name="Escanear producto"><bpmn:documentation>Lectura del codigo_barras (EAN-13) de PRODUCTO.</bpmn:documentation><bpmn:incoming>Flow_A1_A2</bpmn:incoming><bpmn:incoming>Flow_A4_A2</bpmn:incoming><bpmn:outgoing>Flow_A2_A3</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="A3" name="Consultar producto, precio y stock"><bpmn:documentation>Meta: respuesta en menos de 1,5 segundos por producto escaneado.</bpmn:documentation><bpmn:incoming>Flow_A2_A3</bpmn:incoming><bpmn:outgoing>Flow_A3_A4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="A4" name="¿Hay más productos?"><bpmn:incoming>Flow_A3_A4</bpmn:incoming><bpmn:outgoing>Flow_A4_A5</bpmn:outgoing><bpmn:outgoing>Flow_A4_A2</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="A5" name="Cobrar al cliente (medio de pago)"><bpmn:incoming>Flow_A4_A5</bpmn:incoming><bpmn:outgoing>Flow_A5_A6</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="A6" name="Emitir ticket fiscal (Enterprise)"><bpmn:documentation>El software Enterprise sigue emitiendo el comprobante fiscal; no controla inventario.</bpmn:documentation><bpmn:incoming>Flow_A5_A6</bpmn:incoming><bpmn:outgoing>Flow_A6_A7</bpmn:outgoing></bpmn:sendTask>
<bpmn:serviceTask id="A7" name="Registrar la venta y descontar stock"><bpmn:documentation>Crea el registro en VENTA y resta stock_actual en PRODUCTO en tiempo real.</bpmn:documentation><bpmn:incoming>Flow_A6_A7</bpmn:incoming><bpmn:outgoing>Flow_A7_A8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="A8" name="¿Es comida elaborada en cocina?"><bpmn:incoming>Flow_A7_A8</bpmn:incoming><bpmn:outgoing>Flow_A8_A9</bpmn:outgoing><bpmn:outgoing>Flow_A8_A10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="A9" name="Descontar insumos según receta"><bpmn:incoming>Flow_A8_A9</bpmn:incoming><bpmn:outgoing>Flow_A9_A10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="A10"><bpmn:incoming>Flow_A9_A10</bpmn:incoming><bpmn:incoming>Flow_A8_A10</bpmn:incoming><bpmn:outgoing>Flow_A10_A11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="A11" name="¿Stock ≤ mínimo?"><bpmn:incoming>Flow_A10_A11</bpmn:incoming><bpmn:outgoing>Flow_A11_A12</bpmn:outgoing><bpmn:outgoing>Flow_A11_A14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="A12" name="Generar alerta de reposición"><bpmn:documentation>Se dispara cuando stock_actual &lt;= stock_minimo.</bpmn:documentation><bpmn:incoming>Flow_A11_A12</bpmn:incoming><bpmn:outgoing>Flow_A12_A13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:intermediateThrowEvent id="A13" name="Alerta de stock mínimo"><bpmn:incoming>Flow_A12_A13</bpmn:incoming><bpmn:outgoing>Flow_A13_A14</bpmn:outgoing><bpmn:signalEventDefinition id="A13_def" signalRef="Signal_alerta" /></bpmn:intermediateThrowEvent>
<bpmn:exclusiveGateway id="A14"><bpmn:incoming>Flow_A13_A14</bpmn:incoming><bpmn:incoming>Flow_A11_A14</bpmn:incoming><bpmn:outgoing>Flow_A14_A15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="A15" name="Venta registrada"><bpmn:incoming>Flow_A14_A15</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="B1" name="Alerta de stock mínimo"><bpmn:outgoing>Flow_B1_B2</bpmn:outgoing><bpmn:signalEventDefinition id="B1_def" signalRef="Signal_alerta" /></bpmn:startEvent>
<bpmn:userTask id="B2" name="Verificar stock en depósito"><bpmn:incoming>Flow_B1_B2</bpmn:incoming><bpmn:outgoing>Flow_B2_B3</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="B3" name="¿Hay stock en depósito?"><bpmn:incoming>Flow_B2_B3</bpmn:incoming><bpmn:outgoing>Flow_B3_B4</bpmn:outgoing><bpmn:outgoing>Flow_B3_B5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="B4" name="Reponer góndola"><bpmn:incoming>Flow_B3_B4</bpmn:incoming><bpmn:outgoing>Flow_B4_B7</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="B5" name="Informar faltante a Administración"><bpmn:incoming>Flow_B3_B5</bpmn:incoming><bpmn:outgoing>Flow_B5_B6</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="B6" name="Faltante informado"><bpmn:incoming>Flow_B5_B6</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="B7" name="Góndola repuesta"><bpmn:incoming>Flow_B4_B7</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="E1" name="Fin de turno (15:00 / 23:00)"><bpmn:outgoing>Flow_E1_E2</bpmn:outgoing><bpmn:timerEventDefinition id="E1_def" /></bpmn:startEvent>
<bpmn:serviceTask id="E2" name="Calcular total de ventas por medio de pago"><bpmn:documentation>Suma monto_total de VENTA agrupado por medio_pago.</bpmn:documentation><bpmn:incoming>Flow_E1_E2</bpmn:incoming><bpmn:outgoing>Flow_E2_E3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="E3" name="Contar efectivo y comparar con el sistema"><bpmn:incoming>Flow_E2_E3</bpmn:incoming><bpmn:outgoing>Flow_E3_E4</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="E4" name="¿Coincide?"><bpmn:incoming>Flow_E3_E4</bpmn:incoming><bpmn:outgoing>Flow_E4_E7</bpmn:outgoing><bpmn:outgoing>Flow_E4_E5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="E5" name="Investigar y corregir la diferencia"><bpmn:incoming>Flow_E4_E5</bpmn:incoming><bpmn:outgoing>Flow_E5_E7</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="E7"><bpmn:incoming>Flow_E4_E7</bpmn:incoming><bpmn:incoming>Flow_E5_E7</bpmn:incoming><bpmn:outgoing>Flow_E7_E8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E8" name="Turno cerrado"><bpmn:incoming>Flow_E7_E8</bpmn:incoming></bpmn:endEvent>
